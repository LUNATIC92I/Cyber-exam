# CYBER EXAM — root Apache configuration
Options -Indexes -MultiViews
DirectoryIndex index.php
ServerSignature Off

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Force HTTPS (uncomment behind a TLS-terminating proxy only if X-Forwarded-Proto is trusted)
    # RewriteCond %{HTTPS} !=on
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Block access to sensitive files
<FilesMatch "(^\.|\.(env|sql|md|log|lock|ini|sh|dist|json|yml|yaml)$|composer\.(json|lock)|package\.json)">
    Require all denied
</FilesMatch>

# Never serve the seeder or internal tools over the web
<FilesMatch "^(seed|composer)\.php$">
    Require all denied
</FilesMatch>

# Security headers (defence in depth; the app also sets these)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header set X-Powered-By ""
    Header unset X-Powered-By
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/svg+xml "access plus 7 days"
    ExpiresByType font/woff2 "access plus 30 days"
</IfModule>
