# ---------------------------------------------------------------------------
#  CYBER EXAM — environment configuration
#  Copy to .env and fill in. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

APP_ENV=production            # production | local | testing
APP_DEBUG=false               # never true in production
APP_URL=https://www.your-domain.com
APP_TIMEZONE=UTC
# 32+ random bytes. Generate with: php tools/generate-key.php
APP_KEY=
FORCE_HTTPS=true
# Comma-separated IPs of reverse proxies / load balancers allowed to set X-Forwarded-* headers
TRUSTED_PROXIES=

# Database (MySQL 8+)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cyber_exam
DB_USERNAME=cyber_exam
DB_PASSWORD=
DB_SOCKET=

SESSION_IDLE_MINUTES=180

# Payments: stripe (production) | sandbox (local simulator, refused when APP_ENV=production)
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
SANDBOX_WEBHOOK_SECRET=

# Mail: log (writes to storage/mail) | mail (PHP mail()) | smtp
MAIL_DRIVER=smtp
MAIL_HOST=smtp.your-provider.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@your-domain.com

# One-time token enabling /admin/setup.php to create the first super-admin
# (only works while no admin exists). Leave empty to disable.
ADMIN_SETUP_TOKEN=
